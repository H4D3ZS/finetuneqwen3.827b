package android.llama.cpp\r \r import androidx.test.platform.app.InstrumentationRegistry\r import androidx.test.ext.junit.runners.AndroidJUnit4\r \r import org.junit.Test\r import org.junit.runner.RunWith\r \r import org.junit.Assert.*\r \r /**\r  * Instrumented test, which will execute on an Android device.\r  *\r  * See [testing documentation](http://d.android.com/tools/testing).\r  */\r @RunWith(AndroidJUnit4","id":"file_map:ROCmFPX\\examples\\llama.android\\lib\\src\\androidTest\\java\\android\\llama\\cpp\\ExampleInstrumentedTest.kt","metadata":{"extension":"kt","geometry_map":[-0.0363805815577507,0.04216410964727402,0.030597424134612083,0.03521978110074997,0.03601263463497162,0.04853047430515289,0.028613900765776634,-0.027879199013113976,-0.01888125203549862,0.008253710344433784],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\examples\\llama.android\\lib\\src\\androidTest\\java\\android\\llama\\cpp\\ExampleInstrumentedTest.kt","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":691},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\ggml\\src\\ggml-opencl\\kernels\\im2col_f32.cl: #pragma OPENCL EXTENSION cl_khr_fp16 : enable\r \r kernel void kernel_im2col_f32(\r         global float * src1,\r         ulong offset1,\r         global float * dst,\r         ulong offsetd,\r         ulong batch_offset,\r         ulong delta_offset,\r         long IW,\r         long IH,\r         long IC,\r         long OW,\r         long OH,\r         long KW,\r         long KH,\r         long pelements,\r    ","id":"file_map:ROCmFPX\\ggml\\src\\ggml-opencl\\kernels\\im2col_f32.cl","metadata":{"extension":"cl","geometry_map":[-0.04998169466853142,0.03837229311466217,0.028656700626015663,0.042320381850004196,0.031774140894412994,0.03367991745471954,0.03734687343239784,-0.028156274929642677,-0.01625385507941246,0.01958334445953369],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\ggml\\src\\ggml-opencl\\kernels\\im2col_f32.cl","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":1426},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\common\\chat-auto-parser.h: #pragma once\r \r #include \"chat.h\"\r #include \"common.h\"\r #include \"jinja/caps.h\"\r #include \"peg-parser.h\"\r #include \"nlohmann/json.hpp\"\r \r #include <chrono>\r #include <optional>\r #include <string>\r #include <utility>\r #include <vector>\r \r using json = nlohmann::ordered_json;\r \r class common_chat_peg_builder;\r \r // ============================================================================\r // Para","id":"file_map:ROCmFPX\\common\\chat-auto-parser.h","metadata":{"extension":"h","geometry_map":[-0.04938430339097977,0.040362242609262466,0.03577488660812378,0.036123521625995636,0.01658186875283718,0.04113321378827095,0.018443504348397255,-0.010594005696475506,-0.01778407208621502,-0.0003994655271526426],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\common\\chat-auto-parser.h","security":{"audit_needed":false,"risk_level":0.30000001192092896,"security_tier":"STANDARD"},"size":18310},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\examples\\simple-cmake-pkg\\CMakeLists.txt: cmake_minimum_required(VERSION 3.12)\r project(llama-simple-cmake-pkg)\r \r set(TARGET llama-simple-cmake-pkg)\r \r find_package(Llama REQUIRED)\r \r add_executable(${TARGET} ${CMAKE_CURRENT_LIST_DIR}/../simple/simple.cpp)\r install(TARGETS ${TARGET} RUNTIME)\r target_link_libraries(${TARGET} PRIVATE llama ggml::all ${CMAKE_THREAD_LIBS_INIT})\r target_compile_features(${TARGET} PRIVATE cxx_std_17)\r ","id":"file_map:ROCmFPX\\examples\\simple-cmake-pkg\\CMakeLists.txt","metadata":{"extension":"txt","geometry_map":[-0.03579625487327576,0.038095224648714066,0.026818960905075073,0.032663971185684204,0.03540004789829254,0.04203752428293228,0.03681918606162071,-0.023163987323641777,-0.01354996208101511,0.011250986717641354],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\examples\\simple-cmake-pkg\\CMakeLists.txt","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":392},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\examples\\model-conversion\\scripts\\causal\\run-converted-model-embeddings-logits.sh: #!/usr/bin/env bash\r \r set -e\r \r # First try command line argument, then environment variable, then file\r CONVERTED_MODEL=\"${1:-\"$CONVERTED_MODEL\"}\"\r BUILD_DIR=\"${2:-\"$BUILD_DIR\"}\"\r \r # Final check if we have a model path\r if [ -z \"$CONVERTED_MODEL\" ]; then\r     echo \"Error: Model path must be provided either as:\" >&2\r     echo \"  1. Command line argument\" >&2\r     echo \"  2. CONVERTED_MODEL envir","id":"file_map:ROCmFPX\\examples\\model-conversion\\scripts\\causal\\run-converted-model-embeddings-logits.sh","metadata":{"extension":"sh","geometry_map":[-0.03348321467638016,0.03919053450226784,0.032384876161813736,0.02909673936665058,0.029074978083372116,0.04642501100897789,0.03087380714714527,-0.029008187353610992,-0.013441669754683971,0.0030606845393776894],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\examples\\model-conversion\\scripts\\causal\\run-converted-model-embeddings-logits.sh","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":659},"tags":[],"timestamp":1786891162},{"category":"fix_lessons","content":"ROCmFPX\\docs\\backend\\zDNN.md: # llama.cpp for IBM zDNN Accelerator\r \r > [!WARNING]\r > **Note:** zDNN is **not** the same as ZenDNN.\r > - **zDNN** (this page): IBM's Deep Neural Network acceleration library for IBM Z & LinuxONE Mainframes\r > - **ZenDNN**: AMD's deep learning library for AMD EPYC CPUs ([see ZenDNN documentation](ZenDNN.md))\r \r ## Background\r \r IBM zDNN (Z Deep Neural Network) is a hardware acceleration library designed specifically to leverage the IBM NNPA (Neural Network Processor Assist) accelerator located within IBM Telum I and II processors. It provides significant performance improvements for neural network inference operations.\r \r ### Llama.cpp + IBM zDNN\r \r The llama.cpp zDNN backend is designed to enable llama.cpp on IBM z17 and later systems via the IBM zDNN hardware acceleration library.\r \r ## Software & Hardware Support\r \r | Hardware Level       | Status        | Verified                   |\r | -------------------- | ------------- | -------------------------- |\r | IBM z17 / LinuxONE 5 | Supported     | RHEL 9.6, IBM z17, 40 IFLs |\r | IBM z16 / LinuxONE 4 | Not Supported |                            |\r \r ## Data Types Supported\r \r | Data Type | Status    |\r | --------- | --------- |\r |","id":"fix_lessons:ROCmFPX\\docs\\backend\\zDNN.md","metadata":{"extension":"md","geometry_map":[-0.02804872952401638,0.03929204121232033,0.044332463294267654,0.03186177462339401,0.02768867276608944,0.045887719839811325,0.03041417896747589,-0.024648601189255714,-0.02722386084496975,0.005397170782089233],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\docs\\backend\\zDNN.md","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":2367},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\ggml\\src\\ggml-opencl\\kernels\\rms_norm.cl: #pragma OPENCL EXTENSION cl_khr_fp16 : enable\r \r #ifdef cl_intel_subgroups\r #pragma OPENCL EXTENSION cl_intel_subgroups : enable\r #else\r #pragma OPENCL EXTENSION cl_khr_subgroups : enable\r #endif\r \r #ifdef cl_intel_required_subgroup_size\r #pragma OPENCL EXTENSION cl_intel_required_subgroup_size : enable\r #define INTEL_GPU 1\r #define REQD_SUBGROUP_SIZE_16 __attribute__((intel_reqd_sub_group_size(16","id":"file_map:ROCmFPX\\ggml\\src\\ggml-opencl\\kernels\\rms_norm.cl","metadata":{"extension":"cl","geometry_map":[-0.04956371709704399,0.0376628078520298,0.028906648978590965,0.04110485315322876,0.03326764702796936,0.03333607316017151,0.03623936325311661,-0.029144687578082085,-0.01729924976825714,0.018412616103887558],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\ggml\\src\\ggml-opencl\\kernels\\rms_norm.cl","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":5967},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\common\\speculative.h: #pragma once\r \r #include \"llama.h\"\r #include \"common.h\"\r \r struct common_speculative;\r \r // comma separated list the provided types\r std::string common_speculative_type_name_str(const std::vector<enum common_speculative_type> & types);\r \r // comma separated list of all types\r const char * common_speculative_all_types_str();\r \r // parse user provided types\r std::vector<enum common_speculative_type>","id":"file_map:ROCmFPX\\common\\speculative.h","metadata":{"extension":"h","geometry_map":[-0.05399622023105621,0.03198441118001938,0.04080718010663986,0.03758380934596062,0.014364329166710377,0.04247486591339111,0.024372486397624016,-0.014719522558152676,-0.020901579409837723,0.0004991770256310701],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\common\\speculative.h","security":{"audit_needed":false,"risk_level":0.30000001192092896,"security_tier":"STANDARD"},"size":3767},"tags":[],"timestamp":1786891162},{"category":"fix_lessons","content":"ROCmFPX\\docs\\build.md: # Build llama.cpp locally\r \r The main product of this project is the `llama` library. Its C-style interface can be found in [include/llama.h](../include/llama.h).\r \r The project also includes many example programs and tools using the `llama` library. The examples range from simple, minimal code snippets to sophisticated sub-projects such as an OpenAI-compatible HTTP server.\r \r **To get the Code:**\r \r ```bash\r git clone https://github.com/ggml-org/llama.cpp\r cd llama.cpp\r ```\r \r The following sections describe how to build with different backends and options.\r \r * [CPU Build](#cpu-build)\r * [BLAS Build](#blas-build)\r * [Metal Build](#metal-build)\r * [SYCL](#sycl)\r * [CUDA](#cuda)\r * [MUSA](#musa)\r * [HIP](#hip)\r * [Vulkan](#vulkan)\r * [CANN](#cann)\r * [Arm® KleidiAI™](#arm-kleidiai)\r * [OpenCL](#opencl)\r * [Android](#android-1)\r * [OpenVINO](#openvino)\r * [Notes about GPU-accelerated backends](#notes-about-gpu-accelerated-backends)\r \r ## CPU Build\r \r Build llama.cpp using `CMake`:\r \r ```bash\r cmake -B build\r cmake --build build --config Release\r ```\r \r **Notes**:\r \r - For faster compilation, add the `-j` argument to run multiple jobs in parallel, or use a generator that does this au","id":"fix_lessons:ROCmFPX\\docs\\build.md","metadata":{"extension":"md","geometry_map":[-0.03108244016766548,0.03586163744330406,0.04184223711490631,0.025951405987143517,0.026363497599959373,0.04099315404891968,0.024092376232147217,-0.027166202664375305,-0.02524976059794426,0.006747427396476269],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\docs\\build.md","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":38608},"tags":[],"timestamp":1786891162},{"category":"fix_lessons","content":"ROCmFPX\\docs\\ROCmFP4-ARCH-FIT-RESULTS.md: # ROCmFP4 Arch-Fit Results (third-party)\r \r Independent measurements of `Q4_0_ROCMFP4_STRIX_LEAN` across four model architectures on a Ryzen AI Max+ 395 (gfx1151 / Radeon 8060S), 128 GB unified memory, ROCm 7.2.4.\r \r Contributed to answer a question I had before starting and could not find answered anywhere: **which architectures actually get faster under ROCmFP4, and by how much?**\r \r All four builds used this fork. Failures are included.\r \r ## Summary\r \r | Model | Arch | Active params | Decode @ short | Decode @ long | Size | Baseline |\r |---|---|---:|---:|---:|---:|---|\r | Laguna-S-2.1 118B-A8B | `laguna` | ~8B | **+62.6%** | **+43.6%** | −18% | Q4_K_M |\r | Step-3.7-Flash 198B MoE | `step35` | ~11B | **+18%** | **+20%** | +10% | UD-IQ4_XS |\r | Leanstral-1.5 119B-A6B | `deepseek2` (MLA) | ~6.5B | +1.5% | **−8.2%** | −13% | Q4_K_M |\r | KAT-Coder-V2.5-Dev 35B-A3B | `qwen35moe` (hybrid linear) | ~3B | +12% | **−37%** | −2.4 GiB | Q4_K_M |\r \r Baselines are not uniform. Step-3.7-Flash was compared against `UD-IQ4_XS` (~3.9 BPW), which is why its size went *up* — `STRIX_LEAN` is ~4.26 BPW. Against `Q4_K_M`, ROCmFP4 came out 13–18% smaller in every case.\r \r ## Detail\r \r **Laguna-S-2.1**","id":"fix_lessons:ROCmFPX\\docs\\ROCmFP4-ARCH-FIT-RESULTS.md","metadata":{"extension":"md","geometry_map":[-0.030628543347120285,0.03418269008398056,0.03707914799451828,0.03121800348162651,0.03153643012046814,0.042782243341207504,0.03207835555076599,-0.02550179325044155,-0.02258712612092495,0.0064996578730642796],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\docs\\ROCmFP4-ARCH-FIT-RESULTS.md","security":{"audit_needed":false,"risk_level":0.30000001192092896,"security_tier":"STANDARD"},"size":4170},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\ggml\\src\\ggml-vulkan\\vulkan-shaders\\dequant_q5_1.comp: #version 450\r \r #include \"dequant_head.glsl\"\r \r layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;\r \r layout (binding = 0) readonly buffer A {block_q5_1 data_a[];};\r layout (binding = 1) writeonly buffer D {D_TYPE data_b[];};\r \r void main() {\r     const uint i = gl_WorkGroupID.x * 4 + gl_LocalInvocationID.x / 64;\r \r     const uint tid = gl_LocalInvocationID.x % 64;\r     const uint ","id":"file_map:ROCmFPX\\ggml\\src\\ggml-vulkan\\vulkan-shaders\\dequant_q5_1.comp","metadata":{"extension":"comp","geometry_map":[-0.04744124040007591,0.03623150289058685,0.023033877834677696,0.04194114729762077,0.029393114149570465,0.036373548209667206,0.03958185017108917,-0.032253969460725784,-0.014371364377439022,0.014670653268694878],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\ggml\\src\\ggml-vulkan\\vulkan-shaders\\dequant_q5_1.comp","security":{"a