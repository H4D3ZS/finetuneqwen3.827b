ame = os.getenv('UNRELEASED_MODEL_NAME')\r \r parser = argparse.ArgumentParser(description='Process model with specified path')\r parser.add_argument('--model-path', '-m', hel","id":"file_map:ROCmFPX\\examples\\model-conversion\\scripts\\causal\\run-casual-gen-embeddings-org.py","metadata":{"extension":"py","geometry_map":[-0.035286933183670044,0.03821747377514839,0.03185908868908882,0.029160093516111374,0.030412189662456512,0.04670124128460884,0.03138886019587517,-0.030061567202210426,-0.012956852093338966,0.0038036941550672054],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\examples\\model-conversion\\scripts\\causal\\run-casual-gen-embeddings-org.py","security":{"audit_needed":false,"risk_level":0.30000001192092896,"security_tier":"STANDARD"},"size":4783},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\examples\\simple-chat\\simple-chat.cpp: #include \"llama.h\"\r #include <clocale>\r #include <cstdio>\r #include <cstring>\r #include <iostream>\r #include <string>\r #include <vector>\r \r static void print_usage(int, char ** argv) {\r     printf(\"\\nexample usage:\\n\");\r     printf(\"\\n    %s -m model.gguf [-c context_size] [-ngl n_gpu_layers]\\n\", argv[0]);\r     printf(\"\\n\");\r }\r \r int main(int argc, char ** argv) {\r     std::setlocale(LC_NUMERIC, ","id":"file_map:ROCmFPX\\examples\\simple-chat\\simple-chat.cpp","metadata":{"extension":"cpp","geometry_map":[-0.030576059594750404,0.041978493332862854,0.02899465337395668,0.031136784702539444,0.031536765396595,0.04754553735256195,0.039880406111478806,-0.025976113975048065,-0.011664040386676788,0.005943356081843376],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\examples\\simple-chat\\simple-chat.cpp","security":{"audit_needed":false,"risk_level":0.30000001192092896,"security_tier":"STANDARD"},"size":7406},"tags":[],"timestamp":1786891162},{"category":"fix_lessons","content":"ROCmFPX\\docs\\build-s390x.md: > [!IMPORTANT]\r > This build documentation is specific only to IBM Z & LinuxONE mainframes (s390x). You can find the build documentation for other architectures: [build.md](build.md).\r \r # Build llama.cpp locally (for s390x)\r \r The main product of this project is the `llama` library. Its C-style interface can be found in [include/llama.h](../include/llama.h).\r \r The project also includes many example programs and tools using the `llama` library. The examples range from simple, minimal code snippets to sophisticated sub-projects such as an OpenAI-compatible HTTP server.\r \r **To get the code:**\r \r ```bash\r git clone https://github.com/ggml-org/llama.cpp\r cd llama.cpp\r ```\r \r ## CPU Build with BLAS\r \r Building llama.cpp with BLAS support is highly recommended as it has shown to provide performance improvements. Make sure to have OpenBLAS installed in your environment.\r \r ```bash\r cmake -S . -B build             \\\r     -DCMAKE_BUILD_TYPE=Release  \\\r     -DGGML_BLAS=ON              \\\r     -DGGML_BLAS_VENDOR=OpenBLAS\r \r cmake --build build --config Release -j $(nproc)\r ```\r \r **Notes**:\r \r -   For faster repeated compilation, install [ccache](https://ccache.dev/)\r -   By default, VXE/VXE","id":"fix_lessons:ROCmFPX\\docs\\build-s390x.md","metadata":{"extension":"md","geometry_map":[-0.03307279199361801,0.0398213192820549,0.04047904908657074,0.029173845425248146,0.03393947333097458,0.04070889204740524,0.028729956597089767,-0.027516501024365425,-0.029833631590008736,0.0029580348636955023],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\docs\\build-s390x.md","security":{"audit_needed":false,"risk_level":0.30000001192092896,"security_tier":"STANDARD"},"size":11267},"tags":[],"timestamp":1786891162},{"category":"fix_lessons","content":"ROCmFPX\\docs\\backend\\VirtGPU.md: # GGML-VirtGPU Backend\r \r The GGML-VirtGPU backend enables GGML applications to run machine\r learning computations on host hardware while the application itself\r runs inside a virtual machine.  It uses host-guest shared memory to\r efficiently share data buffers between the two sides.\r \r This backend relies on the virtio-gpu, and VirglRenderer API Remoting\r (APIR) component. The backend is split into two libraries:\r - a GGML implementation (the \"remoting frontend\"), running in the\r   guest and interacting with the virtgpu device\r - a VirglRenderer APIR compatible library (the \"remoting backend\"),\r   running in the host and interacting with Virglrenderer and an actual\r   GGML device backend.\r \r ## OS support\r \r | OS       | Status            | Backend     | CI testing  | Notes\r | -------- | ----------------- | ----------- | ----------- | -----\r | MacOS 14 | Supported         | ggml-metal  | X           | Working when compiled on MacOS 14\r | MacOS 15 | Supported         | ggml-metal  | X           | Working when compiled on MacOS 14 or MacOS 15\r | MacOS 26 | Not tested        |             |             |\r | Linux    | Under development | ggml-vulkan | not working | Working locally, C","id":"fix_lessons:ROCmFPX\\docs\\backend\\VirtGPU.md","metadata":{"extension":"md","geometry_map":[-0.027253778651356697,0.0404411219060421,0.04138555750250816,0.028776302933692932,0.028939520940184593,0.043114613741636276,0.03247479721903801,-0.026217317208647728,-0.02692003734409809,0.0034316505771130323],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\docs\\backend\\VirtGPU.md","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":6409},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\common\\json-partial.cpp: #include \"json-partial.h\"\r \r #include \"log.h\"\r \r #include <nlohmann/json.hpp>\r \r #include <string>\r #include <regex>\r \r using json = nlohmann::ordered_json;\r \r enum common_json_stack_element_type {\r     COMMON_JSON_STACK_ELEMENT_OBJECT,\r     COMMON_JSON_STACK_ELEMENT_KEY,\r     COMMON_JSON_STACK_ELEMENT_ARRAY,\r };\r \r struct common_json_stack_element {\r     common_json_stack_element_type type;\r     ","id":"file_map:ROCmFPX\\common\\json-partial.cpp","metadata":{"extension":"cpp","geometry_map":[-0.05207012593746185,0.030887700617313385,0.04150781407952309,0.04363422468304634,0.01535650622099638,0.04293043538928032,0.019899940118193626,-0.012823689728975296,-0.016887137666344643,0.002329850336536765],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\common\\json-partial.cpp","security":{"audit_needed":false,"risk_level":0.30000001192092896,"security_tier":"STANDARD"},"size":16274},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\common\\speculative.cpp: #include \"speculative.h\"\r \r #include \"common.h\"\r #include \"ggml.h\"\r #include \"llama.h\"\r #include \"../src/llama-ext.h\" // staging API: llama_set_embeddings_pre_norm / llama_get_embeddings_pre_norm_ith (used by MTP)\r #include \"log.h\"\r #include \"ngram-cache.h\"\r #include \"ngram-map.h\"\r #include \"ngram-mod.h\"\r #include \"sampling.h\"\r \r #include <algorithm>\r #include <cassert>\r #include <cstdlib>\r #inclu","id":"file_map:ROCmFPX\\common\\speculative.cpp","metadata":{"extension":"cpp","geometry_map":[-0.049800775945186615,0.0349716879427433,0.03680350258946419,0.034575603902339935,0.011381242424249649,0.04011081904172897,0.025438060984015465,-0.008398817852139473,-0.020906569436192513,0.0020331197883933783],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\common\\speculative.cpp","security":{"audit_needed":false,"risk_level":0.30000001192092896,"security_tier":"STANDARD"},"size":121911},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\ggml\\src\\ggml-vulkan\\vulkan-shaders\\dequant_q5_0.comp: #version 450\r \r #include \"dequant_head.glsl\"\r \r layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;\r \r layout (binding = 0) readonly buffer A {block_q5_0 data_a[];};\r layout (binding = 1) writeonly buffer D {D_TYPE data_b[];};\r \r void main() {\r     const uint i = gl_WorkGroupID.x * 4 + gl_LocalInvocationID.x / 64;\r \r     const uint tid = gl_LocalInvocationID.x % 64;\r     const uint ","id":"file_map:ROCmFPX\\ggml\\src\\ggml-vulkan\\vulkan-shaders\\dequant_q5_0.comp","metadata":{"extension":"comp","geometry_map":[-0.04710162431001663,0.03600790351629257,0.024291876703500748,0.04142678901553154,0.03116339072585106,0.03579648584127426,0.03838866949081421,-0.03170941397547722,-0.01664126291871071,0.015268877148628235],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\ggml\\src\\ggml-vulkan\\vulkan-shaders\\dequant_q5_0.comp","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":1075},"tags":[],"timestamp":1786891162},{"category":"fix_lessons","content":"ROCmFPX\\docs\\recipes\\step35-rocmfpx-q3-qualityplus.md: # ROCmFPX Q3 QualityPlus Recipe for Step35 MoE\r \r Internal recipe ID: `rocmfpx-q3.step35.moe.qualityplus.v1`\r \r This is the recipe used by the released\r `Step-3.7-Flash-ROCmFPX-Q3-QualityPlus-*.gguf` artifact set in\r `jcbtc/Step-3.7-Flash-ROCmFPX-Q3-QualityPlus`.\r \r `QualityPlus` is part of this released recipe label. Do not shorten the recipe\r to generic `Q3`, and do not rename the released model.\r \r ## Contract\r \r | Field | Value |\r | --- | --- |\r | Implementation | `step35` |\r | Topology | MoE, 288 experts with 8 active experts |\r | Public recipe label | `ROCmFPX Q3 QualityPlus` |\r | Stable recipe ID | `rocmfpx-q3.step35.moe.qualityplus.v1` |\r | Released build size | 3.57 BPW, 9 GGUF shards |\r \r ## Released Tensor Policy\r \r - Large routed `ffn_*_exps` tensors: `Q3_0_ROCMFPX`\r - Attention query and output tensors: `Q5_K`\r - Attention key and value tensors: `Q4_K`\r - Shared and dense FFN tensors: `Q5_K`\r - Output and token embeddings: `Q4_0_ROCMFP4_FAST`\r \r This routing is tied to Step35's expert and attention structure. It is not a\r generic Q3 recipe for Qwen35 or Gemma4.\r ","id":"fix_lessons:ROCmFPX\\docs\\recipes\\step35-rocmfpx-q3-qualityplus.md","metadata":{"extension":"md","geometry_map":[-0.025901708751916885,0.04203220456838608,0.039961449801921844,0.030010106042027473,0.035133980214595795,0.044113174080848694,0.03289863467216492,-0.024656197056174278,-0.02769479528069496,0.009725711308419704],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\docs\\recipes\\step35-rocmfpx-q3-qualityplus.md","security":{"audit_needed":false,"risk_level":0.30000001192092896,"security_tier":"STANDARD"},"size":1092},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\examples\\gguf-hash\\deps\\sha1\\sha1.c: /*\r SHA-1 in C\r By Steve Reid <steve@edmweb.com>\r 100% Public Domain\r \r Test Vectors (from FIPS PUB 180-1)\r \"abc\"\r   A9993E36 4706816A BA3E2571 7850C26C 9CD0D89D\r \"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq\"\r   84983E44 1C3BD26E BAAE4AA1 F95129E5 E54670F1\r A million repetitions of \"a\"\r   34AA973C D4C4DAA4 F61EEB2B DBAD2731 6534016F\r */\r \r /* #define LITTLE_ENDIAN * This should be #de","id":"file_map:ROCmFPX\\examples\\gguf-hash\\deps\\sha1\\sha1.c","metadata":{"extension":"c","geometry_map":[-0.03367645666003227,0.042756542563438416,0.025395704433321953,0.03472304716706276,0.03149202838540077,0.041631828993558884,0.038105349987745285,-0.025565804913640022,-0.017826711758971214,0.0032244171015918255],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\examples\\gguf-hash\\deps\\sha1\\sha1.c","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":7918},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\ggml\\src\\ggml-sycl\\template-instances\\fattn-vec-instance-q5_0-q8_0.cpp: // This file has been autogenerated by generate_cu_files.py, do not edit manually.\r \r #include \"../fattn-vec.hpp\"\r \r DECL_FATTN_VEC_CASE( 64, GGML_TYPE_Q5_0, GGML_TYPE_Q8_0);\r DECL_FATTN_VEC_CASE(128, GGML_TYPE_Q5_0, GGML_TYPE_Q8_0);\r DECL_FATTN_VEC_CASE(256, GGML_TYPE_Q5_0