-grammar.h","metadata":{"extension":"h","geometry_map":[-0.05000627413392067,0.03144166246056557,0.036899980157613754,0.03621760755777359,0.01609775982797146,0.041101064532995224,0.017986098304390907,-0.011322548612952232,-0.014126685447990894,-0.0024753042962402105],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\common\\json-schema-to-grammar.h","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":1477},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\examples\\model-conversion\\scripts\\causal\\modelcard.template: ---\r base_model:\r - {base_model}\r ---\r # {model_name} GGUF\r \r Recommended way to run this model:\r \r ```sh\r llama-server -hf {namespace}/{model_name}-GGUF\r ```\r \r Then, access http://localhost:8080\r ","id":"file_map:ROCmFPX\\examples\\model-conversion\\scripts\\causal\\modelcard.template","metadata":{"extension":"template","geometry_map":[-0.03385142982006073,0.0386611670255661,0.031788356602191925,0.02879750169813633,0.028621727600693703,0.04502580314874649,0.03246961161494255,-0.028909634798765182,-0.012073411606252193,0.0036913857329636812],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\examples\\model-conversion\\scripts\\causal\\modelcard.template","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":198},"tags":[],"timestamp":1786891162},{"category":"fix_lessons","content":"ROCmFPX\\docs\\backend\\VirtGPU\\development.md: # Development and Testing\r \r ## Development\r \r ### Code Generation\r \r The backend uses code generation from YAML configuration:\r \r ```bash\r # Regenerate protocol code\r cd ggml-virtgpu/\r python regenerate_remoting.py\r ```\r \r ### Adding New Operations\r \r 1. Add function definition to `ggmlremoting_functions.yaml`\r 2. Regenerate code with `regenerate_remoting.py`\r 3. Implement guest-side forwarding in `virtgpu-forward-*.cpp`\r 4. Implement host-side handling in `backend-dispatched-*.cpp`\r \r ## Testing\r \r This document provides instructions for building and testing the GGML-VirtGPU backend on macOS with containers.\r \r ### Prerequisites\r \r The testing setup requires:\r \r - macOS host system\r - Container runtime with `libkrun` provider (podman machine)\r - Access to development patchset for VirglRenderer\r \r ### Required Patchsets\r \r The backend requires patches that are currently under review:\r \r - **Virglrenderer APIR upstream PR**: https://gitlab.freedesktop.org/virgl/virglrenderer/-/merge_requests/1590 (for reference)\r - **MacOS Virglrenderer (for krunkit)**: https://gitlab.freedesktop.org/kpouget/virglrenderer/-/tree/main-macos\r - **Linux Virglrenderer (for krun)**: https://gitlab.freed","id":"fix_lessons:ROCmFPX\\docs\\backend\\VirtGPU\\development.md","metadata":{"extension":"md","geometry_map":[-0.02744792215526104,0.03995096683502197,0.041004762053489685,0.02758137881755829,0.029546067118644714,0.044114403426647186,0.030780095607042313,-0.02583100087940693,-0.024153565987944603,0.005243906285613775],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\docs\\backend\\VirtGPU\\development.md","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":6391},"tags":[],"timestamp":1786891162},{"category":"fix_lessons","content":"ROCmFPX\\docs\\multimodal\\minicpmv4.5.md: ## MiniCPM-V 4.5\r \r ### Prepare models and code\r \r Download [MiniCPM-V-4_5](https://huggingface.co/openbmb/MiniCPM-V-4_5) PyTorch model from huggingface to \"MiniCPM-V-4_5\" folder.\r \r \r ### Build llama.cpp\r Readme modification time: 20250826\r \r If there are differences in usage, please refer to the official build [documentation](https://github.com/ggml-org/llama.cpp/blob/master/docs/build.md)\r \r Clone llama.cpp:\r ```bash\r git clone https://github.com/ggml-org/llama.cpp\r cd llama.cpp\r ```\r \r Build llama.cpp using `CMake`:\r ```bash\r cmake -B build\r cmake --build build --config Release\r ```\r \r \r ### Usage of MiniCPM-V 4\r \r Convert PyTorch model to gguf files (You can also download the converted [gguf](https://huggingface.co/openbmb/MiniCPM-V-4_5-gguf) by us)\r \r ```bash\r python ./tools/mtmd/legacy-models/minicpmv-surgery.py -m ../MiniCPM-V-4_5\r python ./tools/mtmd/legacy-models/minicpmv-convert-image-encoder-to-gguf.py -m ../MiniCPM-V-4_5 --minicpmv-projector ../MiniCPM-V-4_5/minicpmv.projector --output-dir ../MiniCPM-V-4_5/ --minicpmv_version 6\r python ./convert_hf_to_gguf.py ../MiniCPM-V-4_5/model\r \r # quantize int4 version\r ./build/bin/llama-quantize ../MiniCPM-V-4_5/model/ggml-model","id":"fix_lessons:ROCmFPX\\docs\\multimodal\\minicpmv4.5.md","metadata":{"extension":"md","geometry_map":[-0.030144600197672844,0.038001056760549545,0.037091776728630066,0.03547314926981926,0.03289474919438362,0.045472923666238785,0.024859312921762466,-0.02168373391032219,-0.03200525417923927,0.0058174110017716885],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\docs\\multimodal\\minicpmv4.5.md","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":1725},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\ggml\\src\\ggml-sycl\\template-instances\\fattn-vec-instance-q5_0-q5_1.cpp: // This file has been autogenerated by generate_cu_files.py, do not edit manually.\r \r #include \"../fattn-vec.hpp\"\r \r DECL_FATTN_VEC_CASE( 64, GGML_TYPE_Q5_0, GGML_TYPE_Q5_1);\r DECL_FATTN_VEC_CASE(128, GGML_TYPE_Q5_0, GGML_TYPE_Q5_1);\r DECL_FATTN_VEC_CASE(256, GGML_TYPE_Q5_0, GGML_TYPE_Q5_1);\r DECL_FATTN_VEC_CASE(512, GGML_TYPE_Q5_0, GGML_TYPE_Q5_1);\r ","id":"file_map:ROCmFPX\\ggml\\src\\ggml-sycl\\template-instances\\fattn-vec-instance-q5_0-q5_1.cpp","metadata":{"extension":"cpp","geometry_map":[-0.04789247736334801,0.03590747341513634,0.0249797310680151,0.04023228585720062,0.03440496698021889,0.0396825447678566,0.035941049456596375,-0.031283900141716,-0.016551107168197632,0.013483073562383652],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\ggml\\src\\ggml-sycl\\template-instances\\fattn-vec-instance-q5_0-q5_1.cpp","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":353},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\examples\\llama.android\\app\\src\\main\\res\\drawable\\outline_folder_open_24.xml: <vector xmlns:android=\"http://schemas.android.com/apk/res/android\"\r     android:width=\"24dp\"\r     android:height=\"24dp\"\r     android:viewportWidth=\"24\"\r     android:viewportHeight=\"24\"\r     android:tint=\"?attr/colorControlNormal\">\r   <path\r       android:fillColor=\"@android:color/white\"\r       android:pathData=\"M20,6h-8l-2,-2L4,4c-1.1,0 -1.99,0.9 -1.99,2L2,18c0,1.1 0.9,2 2,2h16c1.1,0 2,-0.9 2,-2L2","id":"file_map:ROCmFPX\\examples\\llama.android\\app\\src\\main\\res\\drawable\\outline_folder_open_24.xml","metadata":{"extension":"xml","geometry_map":[-0.03453683853149414,0.04071902483701706,0.029131600633263588,0.035569943487644196,0.033872541040182114,0.047943711280822754,0.031090665608644485,-0.030897069722414017,-0.016577882692217827,0.008233536966145039],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\examples\\llama.android\\app\\src\\main\\res\\drawable\\outline_folder_open_24.xml","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":463},"tags":[],"timestamp":1786891162},{"category":"fix_lessons","content":"ROCmFPX\\docs\\multimodal\\MobileVLM.md: # MobileVLM\r \r Currently this implementation supports [MobileVLM-1.7B](https://huggingface.co/mtgv/MobileVLM-1.7B) / [MobileVLM_V2-1.7B](https://huggingface.co/mtgv/MobileVLM_V2-1.7B) variants.\r \r for more information, please go to [Meituan-AutoML/MobileVLM](https://github.com/Meituan-AutoML/MobileVLM)\r \r The implementation is based on llava, and is compatible with llava and mobileVLM. The usage is basically same as llava.\r \r Notice: The overall process of model inference for both **MobileVLM** and **MobileVLM_V2** models is the same, but the process of model conversion is a little different. Therefore, using **MobileVLM-1.7B** as an example, the different conversion step will be shown.\r \r ## Usage\r \r Build the `llama-mtmd-cli` binary.\r \r After building, run: `./llama-mtmd-cli` to see the usage. For example:\r \r ```sh\r ./llama-mtmd-cli -m MobileVLM-1.7B/ggml-model-q4_k.gguf \\\r     --mmproj MobileVLM-1.7B/mmproj-model-f16.gguf \\\r     --chat-template deepseek\r ```\r \r ## Model conversion\r \r 1. Clone `mobileVLM-1.7B` and `clip-vit-large-patch14-336` locally:\r \r ```sh\r git clone https://huggingface.co/mtgv/MobileVLM-1.7B\r \r git clone https://huggingface.co/openai/clip-vit-large-patch14-3","id":"fix_lessons:ROCmFPX\\docs\\multimodal\\MobileVLM.md","metadata":{"extension":"md","geometry_map":[-0.03384855017066002,0.037889763712882996,0.035294923931360245,0.03293144702911377,0.034494828432798386,0.04679500311613083,0.026737429201602936,-0.02312355302274227,-0.03239607438445091,0.003127995878458023],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\docs\\multimodal\\MobileVLM.md","security":{"audit_needed":false,"risk_level":0.30000001192092896,"security_tier":"STANDARD"},"size":18909},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\ggml\\src\\ggml-vulkan\\vulkan-shaders\\dequant_q4_k.comp: #version 450\r \r #include \"dequant_head.glsl\"\r \r layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;\r \r layout (binding = 0) readonly buffer A {A_TYPE data_a[];};\r layout (binding = 1) writeonly buffer D {D_TYPE data_b[];};\r \r void main() {\r     [[unroll]] for (uint wgy = 0; wgy < 256; wgy++) {\r         const uint ib = gl_WorkGroupID.x * 256 + wgy;\r         if (ib >= p.nel / QUANT_K) ","id":"file_map:ROCmFPX\\ggml\\src\\ggml-vulkan\\vulkan-shaders\\dequant_q4_k.comp","metadata":{"extension":"comp","geometry_map":[-0.0480426624417305,0.03486250713467598,0.0243773367