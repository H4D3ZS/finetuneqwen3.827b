.hpp\"\r \r DECL_FATTN_VEC_CASE( 64, GGML_TYPE_Q5_1, GGML_TYPE_Q8_0);\r DECL_FATTN_VEC_CASE(128, GGML_TYPE_Q5_1, GGML_TYPE_Q8_0);\r DECL_FATTN_VEC_CASE(256, GGML_TYPE_Q5_1, GGML_TYPE_Q8_0);\r DECL_FATTN_VEC_CASE(512, GGML_TYPE_Q5_1, GGML_TYPE_Q8_0);\r ","id":"file_map:ROCmFPX\\ggml\\src\\ggml-sycl\\template-instances\\fattn-vec-instance-q5_1-q8_0.cpp","metadata":{"extension":"cpp","geometry_map":[-0.04976308345794678,0.03757936507463455,0.024981288239359856,0.03987167030572891,0.03560648113489151,0.03871195390820503,0.034660983830690384,-0.03280176222324371,-0.016075024381279945,0.015483158640563488],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\ggml\\src\\ggml-sycl\\template-instances\\fattn-vec-instance-q5_1-q8_0.cpp","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":353},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\examples\\gguf-hash\\deps\\xxhash\\clib.json: {\r   \"name\": \"xxhash\",\r   \"version\": \"0.8.2\",\r   \"repo\": \"Cyan4973/xxhash\",\r   \"description\": \"Extremely fast non-cryptographic hash algorithm\",\r   \"keywords\": [\"xxhash\", \"hashing\"],\r   \"license\": \"BSD-2-Clause\",\r   \"src\": [\r     \"xxhash.c\",\r     \"xxhash.h\"\r   ]\r }\r ","id":"file_map:ROCmFPX\\examples\\gguf-hash\\deps\\xxhash\\clib.json","metadata":{"extension":"json","geometry_map":[-0.03350059315562248,0.043557073920965195,0.024805570021271706,0.034931208938360214,0.028628341853618622,0.04333500564098358,0.0365983210504055,-0.022666659206151962,-0.01819222792983055,0.005314790643751621],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\examples\\gguf-hash\\deps\\xxhash\\clib.json","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":267},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\ggml\\src\\ggml-vulkan\\vulkan-shaders\\dequant_rocmfp4.comp: #version 450\r \r #include \"dequant_head.glsl\"\r \r layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;\r \r layout (binding = 0) readonly buffer A {block_rocmfp4 data_a[];};\r layout (binding = 1) writeonly buffer D {D_TYPE data_b[];};\r \r void main() {\r     const uint i = gl_WorkGroupID.x * 4 + gl_LocalInvocationID.x / 64;\r \r     init_iq_shmem(gl_WorkGroupSize);\r \r     const uint tid = gl","id":"file_map:ROCmFPX\\ggml\\src\\ggml-vulkan\\vulkan-shaders\\dequant_rocmfp4.comp","metadata":{"extension":"comp","geometry_map":[-0.04702857881784439,0.0360693484544754,0.023506762459874153,0.04228982329368591,0.031301215291023254,0.03477757051587105,0.040345460176467896,-0.031757902354002,-0.015921756625175476,0.015462879091501236],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\ggml\\src\\ggml-vulkan\\vulkan-shaders\\dequant_rocmfp4.comp","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":1028},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\ggml\\src\\ggml-cann\\aclnn_ops.h: /**\r  * Copyright (c) 2023-2026 The ggml authors\r  *\r  * Permission is hereby granted, free of charge, to any person obtaining a copy\r  * of this software and associated documentation files (the \"Software\"), to\r  * deal in the Software without restriction, including without limitation the\r  * rights to use, copy, modify, merge, publish, distribute, sublicense, and/or\r  * sell copies of the Softwar","id":"file_map:ROCmFPX\\ggml\\src\\ggml-cann\\aclnn_ops.h","metadata":{"extension":"h","geometry_map":[-0.051417067646980286,0.03752872347831726,0.028352119028568268,0.041181422770023346,0.03493872284889221,0.03435628488659859,0.03627718240022659,-0.02919747680425644,-0.016540134325623512,0.01548992283642292],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\ggml\\src\\ggml-cann\\aclnn_ops.h","security":{"audit_needed":false,"risk_level":0.30000001192092896,"security_tier":"STANDARD"},"size":55323},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\common\\chat-auto-parser-generator.cpp: #include \"chat-auto-parser-helpers.h\"\r #include \"chat-auto-parser.h\"\r #include \"chat-peg-parser.h\"\r #include \"chat.h\"\r #include \"common.h\"\r #include \"json-schema-to-grammar.h\"\r #include \"log.h\"\r #include \"nlohmann/json.hpp\"\r #include \"peg-parser.h\"\r \r #include <stdexcept>\r #include <string>\r \r using json = nlohmann::ordered_json;\r \r // Helper to iterate over tools/functions\r static void foreach_fu","id":"file_map:ROCmFPX\\common\\chat-auto-parser-generator.cpp","metadata":{"extension":"cpp","geometry_map":[-0.04784396290779114,0.038828086107969284,0.041176702827215195,0.041458193212747574,0.016270987689495087,0.04151935130357742,0.02489553391933441,-0.007861408405005932,-0.017779512330889702,0.004033851902931929],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\common\\chat-auto-parser-generator.cpp","security":{"audit_needed":false,"risk_level":0.30000001192092896,"security_tier":"STANDARD"},"size":23254},"tags":[],"timestamp":1786891162},{"category":"fix_lessons","content":"ROCmFPX\\docs\\recipes\\qwen35-moe-rocmfpx-moequality.md: # ROCmFPX MoEQuality Recipe for Qwen35 MoE\r \r Internal recipe ID: `rocmfpx.qwen35.moe.moequality.v1`\r \r This is the Qwen35MoE quality policy used by two released artifacts:\r \r - `CHADROCK-35B-Ace-Saber-MTP-ROCmFPX-MoEQuality-7.07BPW.gguf`\r - `CHADROCK3.6-35B-A3B-Coder-MTP-ROCmFPX-MoEQuality-7.08BPW.gguf`\r \r The artifact names above come from their Hugging Face cards and remain the\r release source of truth. The 7.07 and 7.08 BPW values are outputs from two\r build instances; they do not identify separate recipe policies.\r \r ## Contract\r \r | Field | Value |\r | --- | --- |\r | Implementation | `qwen35moe` |\r | Topology | MoE |\r | Public recipe label | `ROCmFPX MoEQuality` |\r | Policy lineage | H29-B-derived MoE quality tensor policy |\r | Stable recipe ID | `rocmfpx.qwen35.moe.moequality.v1` |\r \r MoEQuality is not the dense Qwen35 UltraQuality recipe. It is also not the\r ROCmFP4 Strix Lean recipe used by the separate ROCmFP4 artifacts in the Ace\r Saber and Coder repositories.\r \r Do not reuse this recipe for dense Qwen, Step35, or Gemma4 from the label\r alone. A new architecture/topology contract and validation pass are required.\r ","id":"fix_lessons:ROCmFPX\\docs\\recipes\\qwen35-moe-rocmfpx-moequality.md","metadata":{"extension":"md","geometry_map":[-0.025961486622691154,0.04093403369188309,0.038856569677591324,0.027582410722970963,0.03305266425013542,0.04316437244415283,0.029707470908761024,-0.021502498537302017,-0.026391590014100075,0.007045458070933819],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\docs\\recipes\\qwen35-moe-rocmfpx-moequality.md","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":1142},"tags":[],"timestamp":1786891162},{"category":"fix_lessons","content":"ROCmFPX\\docs\\build-riscv64-spacemit.md: > [!IMPORTANT]\r > This build documentation is specific only to RISC-V SpacemiT SOCs.\r \r ## Build llama.cpp locally (for riscv64)\r \r 1. Prepare Toolchain For RISCV\r ~~~\r wget https://archive.spacemit.com/toolchain/spacemit-toolchain-linux-glibc-x86_64-v1.1.2.tar.xz\r ~~~\r \r 2. Build\r Below is the build script: it requires utilizing RISC-V vector instructions for acceleration. Ensure the `GGML_CPU_RISCV64_SPACEMIT` compilation option is enabled. The currently supported optimization version is `RISCV64_SPACEMIT_IME1` and `RISCV64_SPACEMIT_IME2`, corresponding to the `RISCV64_SPACEMIT_IME_SPEC` compilation option. Compiler configurations are defined in the `riscv64-spacemit-linux-gnu-gcc.cmake` file. Please ensure you have installed the RISC-V compiler and set the environment variable via `export RISCV_ROOT_PATH={your_compiler_path}`.\r ```bash\r \r cmake -B build \\\r     -DCMAKE_BUILD_TYPE=Release \\\r     -DGGML_CPU_RISCV64_SPACEMIT=ON \\\r     -DGGML_CPU_REPACK=OFF \\\r     -DLLAMA_OPENSSL=OFF \\\r     -DGGML_RVV=ON \\\r     -DGGML_RV_ZVFH=ON \\\r     -DGGML_RV_ZFH=ON \\\r     -DGGML_RV_ZICBOP=ON \\\r     -DGGML_RV_ZIHINTPAUSE=ON \\\r     -DGGML_RV_ZBA=ON \\\r     -DCMAKE_TOOLCHAIN_FILE=${PWD}/cmake/riscv64","id":"fix_lessons:ROCmFPX\\docs\\build-riscv64-spacemit.md","metadata":{"extension":"md","geometry_map":[-0.030961891636252403,0.03420209884643555,0.035156697034835815,0.030103223398327827,0.03352344408631325,0.042731910943984985,0.030558733269572258,-0.028611628338694572,-0.03012269176542759,0.006709361914545298],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\docs\\build-riscv64-spacemit.md","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":6530},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\examples\\model-conversion\\scripts\\embedding\\modelcard.template: ---\r base_model:\r - {base_model}\r ---\r # {model_name} GGUF\r \r Recommended way to run this model:\r \r ```sh\r llama-server -hf {namespace}/{model_name}-GGUF --embeddings\r ```\r \r Then the endpoint can be accessed at http://localhost:8080/embedding, for\r example using `curl`:\r ```console\r curl --request POST \\\r     --url http://localhost:8080/embedding \\\r     --header \"Content-Type: application/json\" \\","id":"file_map:ROCmFPX\\examples\\model-conversion\\scripts\\embedding\\modelcard.template","metadata":{"extension":"template","geometry_map":[-0.03214322775602341,0.0377785786986351,0.030176909640431404,0.029103806242346764,0.029234476387500763,0.04619148373603821,0.03326713293790817,-0.026881365105509758,-0.01230084989219904,0.004749479703605175],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\examples\\model-conversion\\scripts\\embedding\\modelcard.template","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":1378},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\ggml\\src\\ggml-vulkan\\vulkan-shaders\\mul_mat