s  |group   |group|size   |       Driver version|\r |--|-------------------|---------------------------------------|-------|-------|--------","id":"fix_lessons:ROCmFPX\\examples\\sycl\\README.md","metadata":{"extension":"md","geometry_map":[-0.035032983869314194,0.038302067667245865,0.02255403622984886,0.03393891826272011,0.03429422155022621,0.046063825488090515,0.03417891263961792,-0.023916305974125862,-0.015223653987050056,0.009110348299145699],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\examples\\sycl\\README.md","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":1502},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\ggml\\src\\ggml-opencl\\kernels\\solve_tri.cl: #pragma OPENCL EXTENSION cl_khr_fp16 : enable\r \r //------------------------------------------------------------------------------\r // solve_tri\r //------------------------------------------------------------------------------\r kernel void kernel_solve_tri_f32(\r         global uchar * src0,\r         ulong offset0,\r         global uchar * src1,\r         ulong offset1,\r         global uchar * dst,\r  ","id":"file_map:ROCmFPX\\ggml\\src\\ggml-opencl\\kernels\\solve_tri.cl","metadata":{"extension":"cl","geometry_map":[-0.04978078603744507,0.037593189626932144,0.02808401547372341,0.04127556085586548,0.03238602355122566,0.03271232172846794,0.03768391162157059,-0.027329105883836746,-0.017639897763729095,0.020218396559357643],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\ggml\\src\\ggml-opencl\\kernels\\solve_tri.cl","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":1662},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\examples\\model-conversion\\scripts\\utils\\semantic_check.py: #!/usr/bin/env python3\r \r import numpy as np\r import argparse\r import os\r import importlib\r from pathlib import Path\r \r from transformers import AutoTokeniz