ce_hub import HfApi\r import argparse\r import sys\r \r def add_model_to_collection(collection_slug, model_id, note=\"\"):\r     \"\"\"\r     Add a model to an existing collection\r \r     Args:\r         collection_slug: The slug of the collection (e.g., \"username/collection-name-12345\")\r         model_id: The model repository ID (e.g., \"username/model-name\")\r         no","id":"file_map:ROCmFPX\\examples\\model-conversion\\scripts\\utils\\hf-add-model-to-collection.py","metadata":{"extension":"py","geometry_map":[-0.03716636821627617,0.03724134713411331,0.030888710170984268,0.03011057712137699,0.03160256892442703,0.046866606920957565,0.030407818034291267,-0.02843969687819481,-0.012530890293419361,0.002515291329473257],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\examples\\model-conversion\\scripts\\utils\\hf-add-model-to-collection.py","security":{"audit_needed":false,"risk_level":0.30000001192092896,"security_tier":"STANDARD"},"size":2505},"tags":[],"timestamp":1786891162},{"category":"fix_lessons","content":"ROCmFPX\\ci\\README-MUSA.md: ## Running MUSA CI in a Docker Container\r \r Assuming `$PWD` is the root of the `llama.cpp` repository, follow these steps to set up and run MUSA CI in a Docker container:\r \r ### 1. Create a local directory to store cached models, configuration files and venv:\r \r ```bash\r mkdir -p $HOME/llama.cpp/ci-cache\r ```\r \r ### 2. Create a local directory to store CI run results:\r \r ```bash\r mkdir -p $HOME/llama.cpp/ci-results\r ```\r \r ### 3. Start a Docker container and run the CI:\r \r ```bash\r docker run --privileged -it \\\r     -v $HOME/llama.cpp/ci-cache:/ci-cache \\\r     -v $HOME/llama.cpp/ci-results:/ci-results \\\r     -v $PWD:/ws -w /ws \\\r     mthreads/musa:rc4.3.0-devel-ubuntu22.04-amd64\r ```\r \r Inside the container, execute the following commands:\r \r ```bash\r apt update -y && apt install -y bc cmake ccache git python3.10-venv time unzip wget\r git config --global --add safe.directory /ws\r GG_BUILD_MUSA=1 bash ./ci/run.sh /ci-results /ci-cache\r ```\r \r This setup ensures that the CI runs within an isolated Docker environment while maintaining cached files and results across runs.\r ","id":"fix_lessons:ROCmFPX\\ci\\README-MUSA.md","metadata":{"extension":"md","geometry_map":[-0.030302399769425392,0.047604337334632874,0.026591379195451736,0.02123238891363144,0.02421245165169239,0.04928378388285637,0.028328536078333855,-0.014482066966593266,-0.016179092228412628,0.006473136134445667],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\ci\\README-MUSA.md","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":1087},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\ggml\\src\\ggml-cuda\\template-instances\\fattn-vec-instance-bf16-q8_0.cu: // This file has been autogenerated by generate_cu_files.py, do not edit manually.\r \r #include \"../fattn-vec.cuh\"\r \r DECL_FATTN_VEC_CASE( 64, GGML_TYPE_BF16, GGML_TYPE_Q8_0);\r DECL_FATTN_VEC_CASE(128, GGML_TYPE_BF16, GGML_TYPE_Q8_0);\r DECL_FATTN_VEC_CASE(256, GGML_TYPE_BF16, GGML_TYPE_Q8_0);\r ","id":"file_map:ROCmFPX\\ggml\\src\\ggml-cuda\\template-instances\\fattn-vec-instance-bf16-q8_0.cu","metadata":{"extension":"cu","geometry_map":[-0.0475488007068634,0.041262075304985046,0.028272414579987526,0.040225740522146225,0.03702132776379585,0.0397648848593235,0.037338342517614365,-0.02815006673336029,-0.016165612265467644,0.01605922542512417],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\ggml\\src\\ggml-cuda\\template-instances\\fattn-vec-instance-bf16-q8_0.cu","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":294},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\ggml\\src\\ggml-rpc\\transport.h: #pragma once\r \r #include <cstddef>\r #include <cstdint>\r #include <memory>\r \r struct socket_t;\r typedef std::shared_ptr<socket_t> socket_ptr;\r \r static const