electing the framework in the \"Frameworks, Libraries, and Embedded Content\" section\r of the project settings.\r \r ![image](https://github.com/ggml-org/llama.cpp/assets/1991296/2b40284f-8421-47a2-b634-74eece09a299)\r \r Video demonstration:\r \r https://github.com/bachittle/llama.cpp/assets/39804642/e290827a-4edb-4093-9642-2a5e399ec545\r ","id":"fix_lessons:ROCmFPX\\examples\\llama.swiftui\\README.md","metadata":{"extension":"md","geometry_map":[-0.03789357468485832,0.037287283688783646,0.02301890216767788,0.03372471407055855,0.03481637313961983,0.044314417988061905,0.0386844240128994,-0.02404826506972313,-0.008120290003716946,0.008456799201667309],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\examples\\llama.swiftui\\README.md","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":1195},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\ggml\\src\\ggml-sycl\\add-id.cpp: #include <sycl/sycl.hpp>\r #include \"common.hpp\"\r #include \"add-id.hpp\"\r \r static void add_id_kernel(\r     const float* src0,\r     const float* src1,\r     const int32_t* src2,\r     float* dst,\r     int64_t ne0,\r     int64_t ne1,\r     size_t nb01,\r     size_t nb02,\r     size_t nb11,\r     size_t nb21,\r     sycl::nd_item<3> item_ct1) {\r   const int64_t i1 = item_ct1.get_group(2);\r   const int64_t i2 =","id":"file_map:ROCmFPX\\ggml\\src\\ggml-sycl\\add-id.cpp","metadata":{"extension":"cpp","geometry_map":[-0.049989666789770126,0.038461778312921524,0.026107970625162125,0.04280271753668785,0.035194721072912216,0.03833774849772453,0.03547699376940727,-0.03263891115784645,-0.01626954972743988,0.01399158127605915],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\ggml\\src\\ggml-sycl\\add-id.cpp","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":2451},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\examples\\sycl\\win-start-svr.bat: ::