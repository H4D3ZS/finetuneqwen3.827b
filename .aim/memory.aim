185949326,0.009035850875079632],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\examples\\llama.android\\app\\src\\main\\res\\layout\\activity_main.xml","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":3117},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\ggml\\src\\ggml-sycl\\template-instances\\fattn-vec-instance-q5_1-f16.cpp: // This file has been autogenerated by generate_cu_files.py, do not edit manually.\r \r #include \"../fattn-vec.hpp\"\r \r DECL_FATTN_VEC_CASE( 64, GGML_TYPE_Q5_1, GGML_TYPE_F16);\r DECL_FATTN_VEC_CASE(128, GGML_TYPE_Q5_1, GGML_TYPE_F16);\r DECL_FATTN_VEC_CASE(256, GGML_TYPE_Q5_1, GGML_TYPE_F16);\r DECL_FATTN_VEC_CASE(512, GGML_TYPE_Q5_1, GGML_TYPE_F16);\r ","id":"file_map:ROCmFPX\\ggml\\src\\ggml-sycl\\template-instances\\fattn-vec-instance-q5_1-f16.cpp","metadata":{"extension":"cpp","geometry_map":[-0.04964546486735344,0.03636426478624344,0.025822468101978302,0.04079267382621765,0.03608107566833496,0.040398675948381424,0.035114020109176636,-0.031517527997493744,-0.015254736877977848,0.013762895949184895],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\ggml\\src\\ggml-sycl\\template-instances\\fattn-vec-instance-q5_1-f16.cpp","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":349},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\examples\\gguf-hash\\deps\\sha1\\sha1.h: #ifndef SHA1_H\r #define SHA1_H\r \r /*\r    SHA-1 in C\r    By Steve Reid <steve@edmweb.com>\r    100% Public Domain\r  */\r \r #include \"stdint.h\"\r \r #if defined(__cplusplus)\r extern \"C\" {\r #endif\r \r typedef struct\r {\r     uint32_t state[5];\r     uint32_t count[2];\r     unsigned char buffer[64];\r } SHA1_CTX;\r \r void SHA1Transform(\r     uint32_t state[5],\r     const unsigned char buffer[64]\r     );\r \r voi","id":"file_map:ROCmFPX\\examples\\gguf-hash\\deps\\sha1\\sha1.h","metadata":{"extension":"h","geometry_map":[-0.033344998955726624,0.0438230037689209,0.025677751749753952,0.03418402373790741,0.031825318932533264,0.04161402955651283,0.039055343717336655,-0.024981962516903877,-0.01734899915754795,0.002310068579390645],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\examples\\gguf-hash\\deps\\sha1\\sha1.h","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":769},"tags":[],"timestamp":1786891162},{"category":"fix_lessons","content":"ROCmFPX\\docs\\ROCmFP4-MTP-COMPARISON.md: # ROCmFP4 + MTP Comparison\r \r Date: 2026-05-23\r Hardware: Framework AMD Strix Halo 395+ desktop, 128 GB unified RAM\r Merged tree: `llama.cpp-mtp-rocmfp4`\r Branch: `mtp-rocmfp4-strix`\r Build: reproducible with `scripts/build-strix-rocmfp4-mtp.sh`\r \r ## What Was Tested\r \r This compares Qwen3.6 27B MTP against Qwen3.6 27B MTP. It does not compare Qwen to Gemma.\r \r The same merged binary was used for both model files:\r \r `/path/to/llama.cpp-mtp-rocmfp4/build-strix-rocmfp4/bin/llama-cli`\r \r Models:\r \r - ROCmFP4: `/path/to/models/Qwen3.6-27B-MTP-GGUF/Qwen3.6-27B-MTP-BF16-to-ROCmFP4-STRIX_LEAN.gguf`\r - Baseline Q5: `/path/to/models/Qwen3.6-27B-MTP-GGUF/Qwen3.6-27B-UD-Q5_K_XL.gguf`\r \r Shared settings:\r \r - Context window: `262144`\r - Reasoning: off\r - Tools: off\r - MTP: on, `draft-mtp`\r - KV cache: `q4_0` for K and V\r - Prompt tokens/s and generation tokens/s were reported by `llama-cli -st`\r \r Shared flags:\r \r ```bash\r -ngl 999 -c 262144 -b 512 -ub 512 -fa on \\\r -ctk q4_0 -ctv q4_0 --no-mmap --jinja -cnv -st \\\r --reasoning off \\\r --spec-type draft-mtp \\\r --spec-draft-ngl all \\\r --spec-draft-type-k q4_0 \\\r --spec-draft-type-v q4_0 \\\r --spec-draft-n-max 4 \\\r --spec-draft-n-min 0 \\\r --spec-d","id":"fix_lessons:ROCmFPX\\docs\\ROCmFP4-MTP-COMPARISON.md","metadata":{"extension":"md","geometry_map":[-0.031155379489064217,0.03596187010407448,0.04294116050004959,0.03368496149778366,0.03222879767417908,0.039918553084135056,0.03005078248679638,-0.02023962140083313,-0.030560016632080078,0.006060137413442135],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\docs\\ROCmFP4-MTP-COMPARISON.md","security":{"audit_needed":false,"risk_level":0.30000001192092896,"security_tier":"STANDARD"},"size":79378},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\ggml\\src\\ggml-openvino\\utils.cpp: #include \"utils.h\"\r \r #include \"ggml-impl.h\"\r #include \"ggml-openvino-extra.h\"\r #include \"ggml-openvino/ggml-decoder.h\"\r #include \"ggml.h\"\r #include \"openvino/frontend.h\"\r #include \"openvino/input_model.h\"\r \r #include <algorithm>\r #include <cassert>\r #include <cmath>\r #include <cstddef>\r #include <cstdint>\r #include <cstdlib>\r #include <cstring>\r #include <iomanip>\r #include <iostream>\r #include <","id":"file_map:ROCmFPX\\ggml\\src\\ggml-openvino\\utils.cpp","metadata":{"extension":"cpp","geometry_map":[-0.048005834221839905,0.03973314166069031,0.02605067938566208,0.039280690252780914,0.032429274171590805,0.03562703728675842,0.03727871924638748,-0.028129365295171738,-0.014353072270751,0.019652152433991432],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\ggml\\src\\ggml-openvino\\utils.cpp","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":38739},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\examples\\model-conversion\\scripts\\utils\\hf-create-model.py: #!/usr/bin/env python3\r \r from huggingface_hub import HfApi\r import argparse\r \r # This script requires that the environment variable HF_TOKEN is set with your\r # Hugging Face API token.\r api = HfApi()\r \r def load_template_and_substitute(template_path, **kwargs):\r     try:\r         with open(template_path, 'r', encoding='utf-8') as f:\r             template_content = f.read()\r \r         return templ","id":"file_map:ROCmFPX\\examples\\model-conversion\\scripts\\utils\\hf-create-model.py","metadata":{"extension":"py","geometry_map":[-0.03555678576231003,0.03756615146994591,0.032506030052900314,0.028773833066225052,0.031601712107658386,0.04627130925655365,0.030531398952007294,-0.027330486103892326,-0.01315605454146862,0.001408763462677598],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\examples\\model-conversion\\scripts\\utils\\hf-create-model.py","security":{"audit_needed":false,"risk_level":0.30000001192092896,"security_tier":"STANDARD"},"size":2708},"tags":[],"timestamp":1786891162},{"category":"fix_lessons","content":"ROCmFPX\\examples\\simple-cmake-pkg\\README.md: # llama.cpp/example/simple-cmake-pkg\r \r This program builds [simple](../simple) using a relocatable CMake package. It serves as an example of using the `find_package()` CMake command to conveniently include [llama.cpp](https://github.com/ggml-org/llama.cpp) in projects which live outside of the source tree.\r \r ## Building\r \r Because this example is \"outside of the source tree\", it is important to first build/install llama.cpp using CMake. An example is provided here, but please see the [llama.cpp build instructions](../..) for more detailed build instructions.\r \r ### Considerations\r \r When hardware acceleration libraries are used (e.g. CUDA, Metal, Vulkan, etc.), the appropriate dependencies will be searched for automatically. So, for example, when finding a package\r \r ### Build llama.cpp and install to llama.cpp/inst\r \r ```sh\r git clone https://github.com/ggml-org/llama.cpp\r cd llama.cpp\r cmake -S . -B build\r cmake --build build\r cmake --install build --prefix inst\r ```\r \r ### Build simple-cmake-pkg\r \r ```sh\r cd examples/simple-cmake-pkg\r cmake -S . -B build -DCMAKE_PREFIX_PATH=../../inst/lib/cmake\r cmake --build build\r ```\r \r ### Run simple-cmake-pkg\r \r ```sh\r ./build/llama-simpl","id":"fix_lessons:ROCmFPX\\examples\\simple-cmake-pkg\\README.md","metadata":{"extension":"md","geometry_map":[-0.037939202040433884,0.03795067593455