alues\\colors.xml","metadata":{"extension":"xml","geometry_map":[-0.033991970121860504,0.04038538038730621,0.028748072683811188,0.036462873220443726,0.03462132439017296,0.04767962172627449,0.030907243490219116,-0.03016059100627899,-0.016528643667697906,0.008767482824623585],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\examples\\llama.android\\app\\src\\main\\res\\values\\colors.xml","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":389},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\ggml\\src\\ggml-opencl\\kernels\\mul_mm_f16_f32_l4_lm.cl: #pragma OPENCL EXTENSION cl_khr_fp16 : enable\r \r #define LOAD_VEC_A 4\r #define LOAD_VEC_B 4\r \r #define BM 64\r #define BN 64\r #define BK 16\r #define TM 4\r #define TN 8\r \r kernel void kernel_mul_mm_f16_f32_l4_lm(\r     global half4 * src0,\r     ulong offset0,\r     global float4 * src1,\r     ulong offset1,\r     global float * dst,\r     ulong offsetd,\r \r     int ne00,\r     int ne01,\r     int ne02,\r    ","id":"file_map:ROCmFPX\\ggml\\src\\ggml-opencl\\kernels\\mul_mm_f16_f32_l4_lm.cl","metadata":{"extension":"cl","geometry_map":[-0.049868401139974594,0.03714313730597496,0.027725789695978165,0.0421818383038044,0.03115442581474781,0.034192975610494614,0.03685402497649193,-0.028252918273210526,-0.018380379304289818,0.018628936260938644],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\ggml\\src\\ggml-opencl\\kernels\\mul_mm_f16_f32_l4_lm.cl","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":4969},"tags":[],"timestamp":1786891162},{"category":"fix_lessons","content":"ROCmFPX\\examples\\gguf-hash\\README.md: \r # llama-gguf-hash\r \r CLI to hash GGUF files to detect difference on a per model and per tensor level.\r \r **Command line options:**\r \r - `--help`: display help message\r - `--xxh64`: use xhash 64bit hash mode (default)\r - `--sha1`: use sha1\r - `--uuid`: use uuid\r - `--sha256`: use sha256\r - `--all`: use all hash\r - `--no-layer`: exclude per layer hash\r - `--uuid`: generate UUIDv5 ID\r - `-c`, `--check <manifest>`:  verify against a manifest\r \r ## About\r \r While most POSIX systems already have hash checking programs like sha256sum, it\r is designed to check entire files. This is not ideal for our purpose if we want\r to check for consistency of the tensor data even if the metadata content of the\r gguf KV store has been updated.\r \r This program is designed to hash a gguf tensor payload on a 'per tensor layer'\r in addition to a 'entire tensor model' hash. The intent is that the entire\r tensor layer can be checked first but if there is any detected inconsistencies,\r then the per tensor hash can be used to narrow down the specific tensor layer\r that has inconsistencies.\r \r For Maintainers:\r - Detection of tensor inconsistency during development and automated tests\r     - This is served by ","id":"fix_lessons:ROCmFPX\\examples\\gguf-hash\\README.md","metadata":{"extension":"md","geometry_map":[-0.03579225018620491,0.040710899978876114,0.02314264513552189,0.0347963385283947,0.032609567046165466,0.04213607683777809,0.04052283987402916,-0.028576543554663658,-0.012722254730761051,0.006599860731512308],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\examples\\gguf-hash\\README.md","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":10868},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\examples\\sycl\\build.sh: #!/usr/bin/env bash\r #  MIT license\r #  Copyright (C) 2024 Intel Corporation\r #  SPDX-License-Identifier: MIT\r \r mkdir -p build\r cd build\r source /opt/intel/oneapi/setvars.sh\r \r #for FP16\r #cmake .. -DGGML_SYCL=ON -DCMAKE_C_COMPILER=icx -DCMAKE_CXX_COMPILER=icpx -DGGML_SYCL_F16=ON -DLLAMA_OPENSSL=OFF # faster for long-prompt inference\r \r #for FP32\r cmake .. -DGGML_SYCL=ON -DCMAKE_C_COMPILER=icx -D","id":"file_map:ROCmFPX\\examples\\sycl\\build.sh","metadata":{"extension":"sh","geometry_map":[-0.0328742191195488,0.04029969498515129,0.021970583125948906,0.03275725245475769,0.03207920119166374,0.04824647679924965,0.029930802062153816,-0.020728765055537224,-0.015182644128799438,0.00870874896645546],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\examples\\sycl\\build.sh","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":683},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\.clang-tidy: ---\r Checks: >\r     bugprone-*,\r     -bugprone-easily-swappable-parameters,\r     -bugprone-implicit-widening-of-multiplication-result,\r     -bugprone-misplaced-widening-cast,\r     -bugprone-narrowing-conversions,\r     readability-*,\r     -readability-avoid-unconditional-preprocessor-if,\r     -readability-function-cognitive-complexity,\r     -readability-identifier-length,\r     -readability-implicit","id":"file_map:ROCmFPX\\.clang-tidy","metadata":{"extension":"","geometry_map":[-0.03914618864655495,0.04303765669465065,0.024741942062973976,0.026412881910800934,0.02517382986843586,0.03671475499868393,0.03735881298780441,-0.022945338860154152,-0.027796700596809387,0.01053939200937748],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\.clang-tidy","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":959},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\ggml\\src\\ggml-sycl\\template-instances\\fattn-vec-instance-q8_0-q5_0.cpp: // This file has been autogenerated by generate_cu_files.py, do not edit manually.\r \r #include \"../fattn-vec.hpp\"\r \r DECL_FATTN_VEC_CASE( 64, GGML_TYPE_Q8_0, GGML_TYPE_Q5_0);\r DECL_FATTN_VEC_CASE(128, GGML_TYPE_Q8_0, GGML_TYPE_Q5_0);\r DECL_FATTN_VEC_CASE(256, GGML_TYPE_Q8_0, GGML_TYPE_Q5_0);\r DECL_FATTN_VEC_CASE(512, GGML_TYPE_Q8_0, GGML_TYPE_Q5_0);\r ","id":"file_map:ROCmFPX\\ggml\\src\\ggml-sycl\\template-instances\\fattn-vec