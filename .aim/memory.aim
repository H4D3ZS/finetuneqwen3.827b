ity_tier":"STANDARD"},"size":143},"tags":[],"timestamp":1786891162},{"category":"fix_lessons","content":"ROCmFPX\\ggml\\rocmfpx\\README.md: # ROCmFPx Experimental Formats\r \r This folder contains the reference layer for the proposed ROCmFP3, ROCmFP6, and\r ROCmFP8 quantization family. It is intentionally separate from `ggml/rocmfp4/`\r so the promoted ROCmFP4 GGUF formats and kernels are not affected while the new\r layouts are evaluated.\r \r ## ROCmFP4 Instructions To Preserve\r \r ROCmFPX is a sibling model-weight quant family, not a new K/V-only compression\r scheme. The promoted ROCmFP4 implementation remains the template for how the\r family should behave in llama.cpp:\r \r - Keep 32-weight blocks so CPU, HIP, and Vulkan kernels can reuse the same\r   Q4/Q8-style reduction shape and GGUF row-size assumptions.\r - Use finite unsigned UE4M3 scale bytes only. `0x7f` and sign-bit scale bytes\r   are invalid, matching the ROCmFP4 validation rule.\r - Prefer reconstruction-MSE scale selection over plain max-abs scaling. ROCmFP4\r   searches each 16-weight half-block; ROCmFP3 and ROCmFP6 follow the same\r   half-block policy, while ROCmFP8 currently uses one full-block scale.\r - Preserve the ROCmFP4 kernel contract: CPU reference quant/dequant/dot first,\r   then HIP/Vulkan `CPY`, `GET_ROWS`, `SET_ROWS`, `MUL_MAT`, and `MUL_MAT_ID`\r   pat","id":"fix_lessons:ROCmFPX\\ggml\\rocmfpx\\README.md","metadata":{"extension":"md","geometry_map":[-0.0434904508292675,0.0364469513297081,0.028826728463172913,0.03540757670998573,0.027080295607447624,0.031651612371206284,0.04195652902126312,-0.03641744330525398,-0.014810409396886826,0.01698406971991062],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\ggml\\rocmfpx\\README.md","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":5617},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\convert_hf_to_gguf.py: #!/usr/bin/env python3\r # -*- coding: utf-8 -*-\r \r from __future__ import annotations\r \r import ast\r import logging\r import argparse\r import contextlib\r import json\r import os\r import re\r import sys\r from enum import IntEnum\r from pathlib import Path\r from hashlib import sha256\r from typing import TYPE_CHECKING, Any, Callable, ContextManager, Iterable, Iterator, Literal, Sequence, TypeVar, cast\r f","id":"file_map:ROCmFPX\\convert_hf_to_gguf.py","metadata":{"extension":"py","geometry_map":[-0.038314610719680786,0.03499121218919754,0.027744730934500694,0.02497381716966629,0.014676233753561974,0.03843332827091217,0.03444758430123329,-0.010582221671938896,-0.016325250267982483,0.01013803668320179],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\convert_hf_to_gguf.py","security":{"audit_needed":false,"risk_level":0.30000001192092896,"security_tier":"STANDARD"},"size":708332},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\ggml\\src\\ggml-vulkan\\vulkan-shaders\\mul_mmq_shmem_types.glsl: #if defined(FA_MMQ_MIXED)\r // Mixed-K flash attention MMQ: superset cache that fits Q4_0/Q4_1/Q5_0/Q5_1/Q8_0.\r // Q4_*/Q5_* only use qs[0..3] and (for Q5_*) qh. Q8_0 uses qs[0..7]. Single-scale\r // types (Q4_0/Q5_0/Q8_0) leave dm.y unused.\r struct block_a_cache {\r     int32_t qs[8];\r     uint32_t qh;\r     FLOAT_TYPEV2 dm;\r };\r #elif defined(DATA_A_Q4_0)\r #define QUANT_R_MMQ 2\r struct block_a_cache","id":"file_map:ROCmFPX\\ggml\\src\\ggml-vulkan\\vulkan-shaders\\mul_mmq_shmem_types.glsl","metadata":{"extension":"glsl","geometry_map":[-0.048892244696617126,0.036082860082387924,0.02367829531431198,0.04109228029847145,0.03050229139626026,0.03601232171058655,0.03929843381047249,-0.03225470706820488,-0.01611352153122425,0.016726547852158546],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\ggml\\src\\ggml-vulkan\\vulkan-shaders\\mul_mmq_shmem_types.glsl","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":2265},"tags":[],"timestamp":1786891162},{"category":"fix_lessons","content":"ROCmFPX\\examples\\retrieval\\README.md: # llama.cpp/examples/retrieval\r \r Demonstration of simple retrieval technique based on cosine similarity\r \r More info:\r https://github.com/ggml-org/llama.cpp/pull/6193\r \r ### How to use\r \r `retieval.cpp` has parameters of its own:\r - `--context-file`: file to be embedded - state this option multiple times to embed multiple files\r - `--chunk-size`: minimum size of each text chunk to be embedded\r - `--chunk-separator`: STRING to divide chunks by. newline by default\r \r `retrieval` example can be tested as follows:\r \r ```bash\r llama-retrieval --model ./models/bge-base-en-v1.5-f16.gguf --top-k 3 --context-file README.md --context-file License --chunk-size 100 --chunk-separator .\r ```\r \r This chunks and embeds all given files and starts a loop requesting query inputs:\r \r ```\r Enter query:\r ```\r \r On each query input, top k chunks are shown along with file name, chunk position within file and original text:\r \r ```\r Enter query: describe the mit license\r batch_decode: n_tokens = 6, n_seq = 1\r Top 3 similar chunks:\r filename: README.md\r filepos: 119\r similarity: 0.762334\r textdata:\r png)\r \r [![License: MIT](https://img.shields.io/badge/license-MIT-blue.svg)](https://opensource.org/licenses/","id":"fix_lessons:ROCmFPX\\examples\\retrieval\\README.md","metadata":{"extension":"md","geometry_map":[-0.03753355145454407,0.04197540134191513,0.03043980896472931,0.03743986412882805,0.02984496019780636,0.04442078620195389,0.036156076937913895,-0.026984866708517075,-0.012311954982578754,0.012119431048631668],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\examples\\retrieval\\README.md","security":{"audit_needed":false,"risk_level":0.30000001192092896,"security_tier":"STANDARD"},"size":2192},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\ggml\\src\\ggml-vulkan\\vulkan-shaders\\conv2d_dw.comp: #version 450\r \r #include \"types.glsl\"\r \r layout (push_constant) uniform parameter\r {\r     uint ne;\r     uint batches;\r     uint channels;\r     uint dst_w;\r     uint dst_h;\r     uint src_w;\r     uint src_h;\r     uint knl_w;\r     uint knl_h;\r     int stride_x;\r     int stride_y;\r     int pad_x;\r     int pad_y;\r     int dilation_x;\r     int dilation_y;\r } p;\r \r layout (binding = 0) readonly buffer A ","id":"file_map:ROCmFPX\\ggml\\src\\ggml-vulkan\\vulkan-shaders\\conv2d_dw.comp","metadata":{"extension":"comp","geometry_map":[-0.04674007371068001,0.03605963662266731,0.022409845143556595,0.042476948350667953,0.031209517270326614,0.034796446561813354,0.038618769496679306,-0.031031860038638115,-0.01587645895779133,0.01523500308394432],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\ggml\\src\\ggml-vulkan\\vulkan-shaders\\conv2d_dw.comp","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":3277},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\ggml\\src\\ggml-virtgpu\\backend\\backend-dispatched.gen.h: #pragma once\r \r /* device */\r uint32_t backend_device_get_device_count(apir_encoder * enc, apir_decoder * dec, virgl_apir_context * ctx);\r uint32_t backend_device_get_count(apir_encoder * enc, apir_decoder * dec, virgl_apir_context * ctx);\r uint32_t backend_device_get_name(apir_encoder * enc, apir_decoder * dec, virgl_apir_context * ctx);\r uint32_t backend_device_get_description(apir_encoder * enc","id":"file_map:ROCmFPX\\ggml\\src\\ggml-virtgpu\\backend\\backend-dispatched.gen.h","metadata":{"extension":"h","geometry_map":[-0.05187700688838959,0.0402551032602787,0.03143106400966644,0.03852412477135658,0.03223695233464241,0.038299012929201126,0.036905236542224884,-0.028876399621367455,-0.016847064718604088,0.01758016087114811],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\ggml\\src\\ggml-virtgpu\\backend\\backend-dispatched.gen.h","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":4716},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\ggml\\src\\ggml-virtgpu\\virtgpu-forward-device.cpp: #include \"virtgpu-forward-impl.h\"\r #include \"virtgpu-shm.h\"\r \r int apir_device_get_count(virtgpu * gpu) {\r     apir_encoder *        encoder;\r     apir_decoder *        decoder;\r     ApirForwardReturnCode ret;\r \r     REMOTE_CALL_PREPARE(gpu, encoder, APIR_COMMAND_TYPE_DEVICE_GET_COUNT);\r     REMOTE_CALL(gpu, encoder, decoder, ret);\r \r     int32_t dev_count = -1;\r     apir_decode_int32_t(decoder, &","id":"file_map:ROCmFPX\\ggml\\src\\ggml-virtgpu\\virtgpu-forward-device.cpp","metadata":{"extension":"cpp","geometry_map":[-0.05081973224878311,0.03832867741584778,0.029190685600042343,0.04085622355341911,0.03200120851397514,0.03742934763431549,0.03696305304765701,-0.028584465384483337,-0.01498484332114458,0.019331272691488266],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\ggml\\src\\ggml-virtgpu\\virtgpu-forward-device.cpp","security":{"audit_needed":false,"risk_level":0.0,"security_tier":"STANDARD"},"size":5849},"tags":[],"timestamp":1786891162},{"category":"fix_lessons","content":"reference\\reference-MTP-and-cliff-findings.md: # MTP decode collapses at exactly `-c 65536` (Vulkan, Qwen3.6-35B-A3B ROCmFP2)  Native MTP sustains ~95 tok/s up to `-c 61440` and drops to ~34 tok/s at `-c 65536` — a 2.7x cliff at exactly 64K, with **identical draft acceptance and essentially identical VRAM on both sides**. That rules out memory pressure and points at a buffer sizing or indexing threshold in the MTP verify path.  Everything else about MTP works well here: at `-c 61440` this model does **80.8 tok/s decode with 0.10 s warm prefill** on an append-only conversation, versus 20.8 tok/s without `--spec-type`. The cliff is the only thing capping usable context.  ## Environment  | | | |---|---| | build | `charlie12345/ROCmFPX` `main` @ `b2f5829` (descendant of `d3ca537`, +12) | | backend | **Vulkan0** — `AMD Radeon RX 9060 XT` (16304 MiB), Windows 10 | | note | this build is Vulkan-only: `GGML_HIP:BOOL=OFF`, no ROCm SDK present | | model | `cafonez/Escha-W2-35B-A3B-ROCmFP2` → `Qwen3.6-35B-A3B-Escha-W2-ROCmFP2.gguf` | | arch | `qwen35moe`, 41 layers, 256 experts / 8 active, native MTP: 1 predict layer | | size | 13,099,217,088 bytes (12.2 GiB), fully resident (`-ngl 99`) |  ## Repro  ``` llama-server -m Qwen3.6-35B-A3B-Esc","id":"fix_lessons:reference\\reference-MTP-and-cliff-findings.md","metadata":{"extension":"md","geometry_map":[0.04057362675666809,0.04015573486685753,0.029263751581311226,0.028608247637748718,0.024134522303938866,-0.011932705529034138,-0.021527612581849098,-0.04503079503774643,-0.0018871878273785114,0.02375490590929985],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\reference\\reference-MTP-and-cliff-findings.md","security":{"audit_needed":false,"risk_level":0.30000001192092896,"security_tier":"STANDARD"},"size":10144},"tags":[],"timestamp":1786891162},{"category":"file_map","content":"ROCmFPX\\ggml\\src\\ggml-virtgpu\\backend\\backend-dispatched.h: #pragma once\r \r // clang-format off\r #include <cstdint>\r #include <cstddef>\r \r #include <ggml-backend.h>\r \r #include \"backend-convert.h\"\r #include \"backend-virgl-apir.h\"\r #include \"shared/apir_backend.h\"\r #include \"shared/apir_cs.h\"\r #include \"shared/apir_cs_ggml.h\"\r // clang-format on\r \r #define GGML_VIRTGPU_BCK \"ggml-virtgpu-backend: \"\r \r struct virgl_apir_context {\r     uint32_t               c","id":"file_map:ROCmFPX\\ggml\\src\\ggml-virtgpu\\backend\\backend-dispatched.h","metadata":{"extension":"h","geometry_map":[-0.04978054389357567,0.040553901344537735,0.03051736392080784,0.040064528584480286,0.032692860811948776,0.03647710755467415,0.03711194545030594,-0.030364802107214928,-0.015573113225400448,0.017083344981074333],"path":"C:\\Users\\HADES\\Desktop\\finetuneqwen3.827b\\ROCmFPX\\ggml\\src\\ggml-virtgpu\\backend\\backen