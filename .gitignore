# Never commit the heavy / private / generated artifacts

# model weights & GGUFs (huge)
*.gguf
*.safetensors
*.bin
*.pt
*.pth
student-distilled/
student-merged/
student-abliterated/
*-abliterated/
*-merged/

# generated data (can be large, and transcripts are PRIVATE)
prompts.jsonl
prompts*.jsonl
node/prompts*.jsonl
teacher_data/
teacher_data*/
node/teacher_data*/
teacher_seed*/
teacher_bulk*/
node/teacher_seed*/
node/teacher_bulk*/
my_transcripts/
my_transcripts.tgz
offload/
/scratch/

# secrets / env — never commit tokens
.env
*.token
hf_token*
HF_TOKEN*

# python
__pycache__/
*.pyc
.venv/
venv/

# os
.DS_Store
Thumbs.db

# logs & external build trees (session-generated)
*.log
node/ROCmFPX/
unsloth_compiled_cache/
node/unsloth_compiled_cache/
node_modules/
package.json
package-lock.json
repo_stage/
